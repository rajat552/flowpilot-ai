# ==============================================================================
# FlowPilot AI — Environment Configuration Example
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Nebius Token Factory (NVIDIA Nemotron Inference)
# Endpoint documentation: https://api.tokenfactory.nebius.com/v1/ or https://api.studio.nebius.ai/v1/
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct

# Search Provider (Optional Tavily API Key; FlowPilot includes built-in web search fallback)
TAVILY_API_KEY=

# Persistence (Optional MongoDB URI; FlowPilot includes an enterprise-grade in-memory store for instant local execution)
MONGODB_URI=
MONGODB_DB_NAME=flowpilot

# Security
JWT_SECRET=flowpilot_super_secure_jwt_secret_change_in_production
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Agent Execution Limits
MAX_STEP_RETRIES=2
STEP_TIMEOUT_MS=60000
WORKFLOW_TIMEOUT_MS=300000
